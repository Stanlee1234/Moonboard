const int SCREEN_WIDTH = 128;
const int SCREEN_HEIGHT = 64;
const uint16_t MATRIX_DEBOUNCE_MS = 25;
const uint16_t MPU_READ_INTERVAL_MS = 30;
const uint16_t DHT_READ_INTERVAL_MS = 2000;

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);
Adafruit_MPU6050 mpu;
DHT dht(DHT_PIN, DHT11);

enum View {
  MENU_VIEW,
  GYRO_VIEW,
  POT_VIEW,
};

View currentView = MENU_VIEW;

bool keyIsDown[NUM_KEYS];
bool keyJustPressed[NUM_KEYS];
bool keyPrevState[NUM_KEYS];
uint32_t keyLastChange[NUM_KEYS];
int lastPressedKeyIndex = -1;

bool mpuFound = false;
bool dhtFound = false;
float accelerationX = 0.0f;
float accelerationY = 0.0f;
float accelerationZ = STANDARD_GRAVITY;
float gyroX = 0.0f;
float gyroY = 0.0f;
float gyroZ = 0.0f;
float mpuTemperatureC = NAN;
float dhtTemperatureC = NAN;
float dhtHumidity = NAN;
float tiltRoll = 0.0f;
float tiltPitch = 0.0f;
bool shakeDetected = false;
uint32_t lastShakeAt = 0;
uint32_t shakeActiveUntil = 0;

uint8_t currentMoonPhase = 4;
uint32_t heartAnimationEndsAt = 0;
uint32_t lastDhtReadAt = 0;
uint32_t lastMpuReadAt = 0;

int keepInRange(int value, int smallest, int largest) {
  return constrain(value, smallest, largest);
}

int readPotentiometer() {
  int raw = analogRead(POT_PIN);
  if (raw > 0) {
    return keepInRange(map(raw, 0, 4095, 0, 100), 0, 100);
  }
  // c3 has no adc on gpio10, fallback to digital
  return (digitalRead(POT_PIN) == HIGH) ? 100 : 0;
}

void triggerHearts() {
  heartAnimationEndsAt = millis() + 1500;
}

void drawHeart(int x, int y) {
  display.fillRect(x - 2, y, 2, 2, SSD1306_WHITE);
  display.fillRect(x + 1, y, 2, 2, SSD1306_WHITE);
  display.fillRect(x - 3, y + 2, 7, 2, SSD1306_WHITE);
  display.fillRect(x - 2, y + 4, 5, 1, SSD1306_WHITE);
  display.fillRect(x - 1, y + 5, 3, 1, SSD1306_WHITE);
  display.drawPixel(x, y + 6, SSD1306_WHITE);
}

void drawHeartsAnim(uint32_t now, int petX, int petY) {
  if (now >= heartAnimationEndsAt) return;
  const float progress = 1.0f - static_cast<float>(heartAnimationEndsAt - now) / 1500.0f;
  const int rise = static_cast<int>(progress * 16.0f);
  drawHeart(petX + 10, petY - 3 - rise);
  drawHeart(petX + 22, petY - 8 - rise / 2);
}

void setUpKeyMatrix() {
  for (int i = 0; i < 2; i++) {
    pinMode(ROW_PINS[i], INPUT);
  }
  for (int i = 0; i < 3; i++) {
    pinMode(COL_PINS[i], INPUT_PULLUP);
  }
  for (int i = 0; i < NUM_KEYS; i++) {
    keyIsDown[i] = false;
    keyJustPressed[i] = false;
    keyPrevState[i] = false;
    keyLastChange[i] = 0;
  }
}

void updateKeyMatrix() {
  const uint32_t now = millis();
  for (int i = 0; i < NUM_KEYS; i++) {
    keyJustPressed[i] = false;
  }

  // active-low matrix scan
  for (int r = 0; r < 2; r++) {
    pinMode(ROW_PINS[r], OUTPUT);
    digitalWrite(ROW_PINS[r], LOW);
    delayMicroseconds(5);

    for (int c = 0; c < 3; c++) {
      int keyIndex = r * 3 + c;
      bool rawDown = (digitalRead(COL_PINS[c]) == LOW);

      if (rawDown != keyPrevState[keyIndex]) {
        if (now - keyLastChange[keyIndex] >= MATRIX_DEBOUNCE_MS) {
          keyLastChange[keyIndex] = now;
          keyPrevState[keyIndex] = rawDown;

          if (rawDown && !keyIsDown[keyIndex]) {
            keyIsDown[keyIndex] = true;
            keyJustPressed[keyIndex] = true;
            lastPressedKeyIndex = keyIndex;
          } else if (!rawDown && keyIsDown[keyIndex]) {
            keyIsDown[keyIndex] = false;
          }
        }
      }
    }
    pinMode(ROW_PINS[r], INPUT);
  }
}

void updateMpu() {
  if (!mpuFound || millis() - lastMpuReadAt < MPU_READ_INTERVAL_MS) {
    return;
  }
  lastMpuReadAt = millis();

  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);

  accelerationX = a.acceleration.x;
  accelerationY = a.acceleration.y;
  accelerationZ = a.acceleration.z;
  gyroX = g.gyro.x;
  gyroY = g.gyro.y;
  gyroZ = g.gyro.z;
  mpuTemperatureC = temp.temperature;

  tiltRoll  = atan2f(accelerationY, accelerationZ) * (180.0f / PI);
  tiltPitch = atan2f(-accelerationX, sqrtf(accelerationY * accelerationY + accelerationZ * accelerationZ)) * (180.0f / PI);

  const float magnitude = sqrtf(accelerationX * accelerationX +
                                accelerationY * accelerationY +
                                accelerationZ * accelerationZ);
  const uint32_t now = millis();
  if (fabsf(magnitude - STANDARD_GRAVITY) >= SHAKE_THRESHOLD &&
      now - lastShakeAt >= SHAKE_COOLDOWN_MS) {
    lastShakeAt = now;
    shakeActiveUntil = now + 400;
    shakeDetected = true;
  }

  if (now > shakeActiveUntil) {
    shakeDetected = false;
  }
}

void updateDht() {
  if (!dhtFound || millis() - lastDhtReadAt < DHT_READ_INTERVAL_MS) {
    return;
  }
  lastDhtReadAt = millis();

  const float newH = dht.readHumidity();
  const float newT = dht.readTemperature();
  if (!isnan(newH)) dhtHumidity = newH;
  if (!isnan(newT)) dhtTemperatureC = newT;
}

void drawMenuView() {
  display.clearDisplay();

  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(2, 0);
  display.print(F("MOONBOARD TESTER"));
  display.drawFastHLine(0, 9, SCREEN_WIDTH, SSD1306_WHITE);

  // 6 buttons on screen
  const int boxW = 19;
  const int boxH = 13;
  const int startX = 3;
  const int startY = 12;
  const int gapX = 3;
  const int gapY = 3;

  for (int r = 0; r < 2; r++) {
    for (int c = 0; c < 3; c++) {
      int idx = r * 3 + c;
      int bx = startX + c * (boxW + gapX);
      int by = startY + r * (boxH + gapY);

      if (keyIsDown[idx]) {
        display.fillRect(bx, by, boxW, boxH, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK);
        display.setCursor(bx + 2, by + 3);
        display.print(KEY_LABELS[idx]);
      } else {
        display.drawRect(bx, by, boxW, boxH, SSD1306_WHITE);
        display.setTextColor(SSD1306_WHITE);
        display.setCursor(bx + 2, by + 3);
        display.print(KEY_LABELS[idx]);
      }
    }
  }

  display.setTextColor(SSD1306_WHITE);
  display.setCursor(70, 12);
  display.print(F("TEMP:"));
  display.setCursor(70, 21);
  if (!isnan(dhtTemperatureC)) {
    display.print(dhtTemperatureC, 1);
    display.print(F("C"));
  } else if (!isnan(mpuTemperatureC)) {
    display.print(mpuTemperatureC, 1);
    display.print(F("C*"));
  } else {
    display.print(F("--.-C"));
  }

  display.setCursor(70, 31);
  display.print(F("HUMID:"));
  display.setCursor(70, 40);
  if (!isnan(dhtHumidity)) {
    display.print((int)dhtHumidity);
    display.print(F(" %"));
  } else {
    display.print(F("-- %"));
  }

  const uint32_t now = millis();
  int floatOffset = static_cast<int>(sinf(now / 350.0f) * 1.5f);
  int petX = 104;
  int petY = 12 + floatOffset;

  display.drawBitmap(petX, petY, MOON_PHASE_BITMAPS[currentMoonPhase], PET_SPRITE_WIDTH, PET_SPRITE_HEIGHT, SSD1306_WHITE);

  display.fillRect(petX + 11, petY + 14, 2, 2, SSD1306_INVERSE);
  display.fillRect(petX + 19, petY + 14, 2, 2, SSD1306_INVERSE);
  display.drawFastHLine(petX + 14, petY + 18, 4, SSD1306_INVERSE);

  drawHeartsAnim(now, petX, petY);

  display.drawFastHLine(0, 47, SCREEN_WIDTH, SSD1306_WHITE);
  display.setCursor(2, 51);

  if (lastPressedKeyIndex >= 0 && keyIsDown[lastPressedKeyIndex]) {
    display.print(F("* "));
    display.print(KEY_LABELS[lastPressedKeyIndex]);
    display.print(F(" PRESSED *"));
  } else {
    display.print(F("SW1:GYRO   SW3:POT"));
  }
}

