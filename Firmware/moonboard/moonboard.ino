  display.drawFastHLine(0, 9, SCREEN_WIDTH, SSD1306_WHITE);

  // bubble level crosshair
  const int boxX = 6;
  const int boxY = 13;
  const int boxSize = 40;

  display.drawRect(boxX, boxY, boxSize, boxSize, SSD1306_WHITE);
  display.drawFastHLine(boxX + 2, boxY + boxSize / 2, boxSize - 4, SSD1306_WHITE);
  display.drawFastVLine(boxX + boxSize / 2, boxY + 2, boxSize - 4, SSD1306_WHITE);
  display.drawCircle(boxX + boxSize / 2, boxY + boxSize / 2, 6, SSD1306_WHITE);

  int bubbleX = (boxX + boxSize / 2) + keepInRange(static_cast<int>(tiltRoll / 2.5f), -16, 16);
  int bubbleY = (boxY + boxSize / 2) + keepInRange(static_cast<int>(tiltPitch / 2.5f), -16, 16);
  display.fillCircle(bubbleX, bubbleY, 3, SSD1306_WHITE);

  display.setCursor(54, 13);
  display.print(F("Roll:  "));
  display.print(static_cast<int>(tiltRoll));
  display.print((char)247);

  display.setCursor(54, 23);
  display.print(F("Pitch: "));
  display.print(static_cast<int>(tiltPitch));
  display.print((char)247);

  display.setCursor(54, 33);
  display.print(F("Temp:  "));
  if (!isnan(mpuTemperatureC)) {
    display.print(mpuTemperatureC, 1);
    display.print(F("C"));
  } else {
    display.print(F("--.-C"));
  }

  display.setCursor(54, 43);
  if (shakeDetected) {
    display.print(F("SHAKE!"));
  } else {
    display.print(F("Motion OK"));
  }

  display.drawFastHLine(0, 55, SCREEN_WIDTH, SSD1306_WHITE);
  display.setCursor(14, 57);
  display.print(F("[SW2] Back to Menu"));
}

void drawPotView() {
  display.clearDisplay();

  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(2, 1);
  display.print(F("POTENTIOMETER TEST"));
  display.drawFastHLine(0, 9, SCREEN_WIDTH, SSD1306_WHITE);

  int percent = readPotentiometer();
  int rawVal = analogRead(POT_PIN);

  const int barX = 14;
  const int barY = 16;
  const int barW = 100;
  const int barH = 14;

  display.drawRect(barX, barY, barW, barH, SSD1306_WHITE);
  int fillWidth = map(percent, 0, 100, 0, barW - 4);
  if (fillWidth > 0) {
    display.fillRect(barX + 2, barY + 2, fillWidth, barH - 4, SSD1306_WHITE);
  }

  display.drawFastVLine(barX + barW / 4, barY + barH, 3, SSD1306_WHITE);
  display.drawFastVLine(barX + barW / 2, barY + barH, 4, SSD1306_WHITE);
  display.drawFastVLine(barX + (3 * barW) / 4, barY + barH, 3, SSD1306_WHITE);

  display.setCursor(18, 35);
  display.print(F("Level:   "));
  display.print(percent);
  display.print(F(" %"));

  display.setCursor(18, 45);
  display.print(F("Pin D10: "));
  display.print((percent > 50) ? F("HIGH") : F("LOW"));
  display.print(F(" (raw "));
  display.print(rawVal);
  display.print(F(")"));

  display.drawFastHLine(0, 55, SCREEN_WIDTH, SSD1306_WHITE);
  display.setCursor(14, 57);
  display.print(F("[SW2] Back to Menu"));
}

void drawCurrentView() {
  if (currentView == GYRO_VIEW) {
    drawGyroView();
  } else if (currentView == POT_VIEW) {
    drawPotView();
  } else {
    drawMenuView();
  }
  display.display();
}

void setup() {
  Serial.begin(115200);

  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);
  Wire.setClock(400000);

  setUpKeyMatrix();
  pinMode(POT_PIN, INPUT);

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    Serial.println(F("[WARN] OLED not found"));
  } else {
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(16, 20);
    display.println(F("MOONBOARD v1.0"));
    display.setCursor(16, 35);
    display.println(F("Starting Suite..."));
    display.display();
  }

  mpuFound = mpu.begin(MPU6050_ADDRESS, &Wire);
  if (mpuFound) {
    mpu.setAccelerometerRange(MPU6050_RANGE_8_G);
    mpu.setGyroRange(MPU6050_RANGE_500_DEG);
    mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);
  }

  if (USE_DHT11) {
    dht.begin();
    dhtFound = true;
  }

  delay(600);
}

void loop() {
  updateKeyMatrix();
  updateMpu();
  updateDht();

  // sw1 = gyro, sw3 = pot, sw2 = back to menu
  if (keyJustPressed[KEY_SW1]) {
    currentView = GYRO_VIEW;
  } else if (keyJustPressed[KEY_SW3]) {
    currentView = POT_VIEW;
  } else if (keyJustPressed[KEY_SW2]) {
    currentView = MENU_VIEW;
  } else if (keyJustPressed[KEY_SW4]) {
    currentMoonPhase = (currentMoonPhase + 1) % 8;
  } else if (keyJustPressed[KEY_SW5] || keyJustPressed[KEY_SW6]) {
    triggerHearts();
  }

  drawCurrentView();
  delay(16);
}
